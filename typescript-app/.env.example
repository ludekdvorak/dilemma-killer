# Local PostgreSQL started by docker compose
DATABASE_URL=postgresql://dilemma:dilemma@localhost:5433/dilemma_killer_ts
TEST_DATABASE_URL=postgresql://dilemma:dilemma@localhost:5433/dilemma_killer_ts_test

# Required in production. Generate at least 32 random bytes.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_SECONDS=604800

PORT=8080
HOST=0.0.0.0
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=15000

# Number of reverse-proxy hops to trust for client IP detection and rate limits.
TRUST_PROXY_HOPS=0

# Demo-only premium button. Never enable this for a real paid deployment.
ALLOW_MOCK_UPGRADE=true

# Safe for this small single-service deployment; an advisory lock prevents races.
RUN_MIGRATIONS_ON_START=true

# GoPay Sandbox: obtain these values from your own GoPay business sandbox.
# APP_BASE_URL must be a public HTTPS URL so GoPay can deliver notifications.
APP_BASE_URL=https://your-public-app.example
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_GATEWAY_URL=https://gw.sandbox.gopay.com/api
